{
  "name": "wusool-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "wrangler dev --port 8787",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check": "astro check",
    "check:dist": "node scripts/check-dist.mjs",
    "test:e2e": "playwright test",
    "lhci": "npx -y @lhci/cli@0.15.1 autorun",
    "gates": "npm run lint && npm run check && npm run check:tokens && npm run check:studio && npm run build && npm run check:dist && npm audit --audit-level=high && npm run test:e2e && npm run lhci",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:studio": "cd studio && npm audit --audit-level=high && npx tsc -p . && npx sanity schema validate"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@portabletext/to-html": "^6.0.0",
    "astro": "^7.4.4",
    "satori": "^0.63.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^1.7.0",
    "node-html-parser": "^9.0.6",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.156.0"
  }
}
