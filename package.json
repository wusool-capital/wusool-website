{
  "name": "wusool-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev --port 8787",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check": "astro check",
    "check:dist": "node scripts/check-dist.mjs",
    "test:e2e": "playwright test",
    "lhci": "npx -y @lhci/cli@0.15.1 autorun",
    "gates": "npm run lint && npm run check && npm run build && npm run check:dist && npm audit --audit-level=high && npm run test:e2e && npm run lhci"
  },
  "dependencies": {
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^1.7.0",
    "node-html-parser": "^9.0.6",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.156.0"
  }
}
