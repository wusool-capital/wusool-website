---
// Questions as native <details>, intro and CTA on the left. First one open.
import Icon from "./Icon.astro";

interface Item {
  question: string;
  answer: string;
  // A phrase of the answer that becomes a link.
  link?: { text?: string; href?: string };
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
const parts = (item: Item) => {
  const at = item.link?.text ? item.answer.indexOf(item.link.text) : -1;
  if (at < 0 || !item.link?.href) return { before: item.answer };
  return {
    before: item.answer.slice(0, at),
    link: { text: item.link.text, href: item.link.href },
    after: item.answer.slice(at + (item.link.text?.length ?? 0)),
  };
};
---

<div class="faq">
  <div class="intro reveal">
    <slot />
  </div>
  <div class="list reveal">
    {items.map((item, i) => (
      <details open={i === 0}>
        <summary>
          {item.question}
          <Icon name="plus" />
        </summary>
        <p>
          {parts(item).before}
          {parts(item).link && (
            <a href={parts(item).link?.href} data-source="faq">
              {parts(item).link?.text}
            </a>
          )}
          {parts(item).after}
        </p>
      </details>
    ))}
  </div>
</div>

<style>
  .faq {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: var(--space-16);
    align-items: start;
  }
  .intro :global(.btn) {
    margin-top: var(--space-7);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  details:first-child {
    border-top: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-5-5) 0;
    color: var(--navy);
    font-size: var(--text-17);
    font-weight: var(--weight-medium);
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary > :global(.icon) {
    box-sizing: content-box;
    width: var(--text-14);
    height: var(--text-14);
    padding: var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    transition:
      transform var(--dur-mid) var(--ease),
      background var(--dur-base);
  }
  details[open] summary > :global(.icon) {
    border-color: var(--navy);
    background: var(--navy);
    color: var(--on-navy);
    transform: rotate(var(--turn-open));
  }
  details a {
    color: var(--navy);
    text-decoration: underline;
    text-underline-offset: var(--nudge);
  }
  details p {
    max-width: var(--measure-body);
    padding: 0 var(--space-12) var(--space-6) 0;
    color: var(--muted);
  }
  @media (max-width: 1080px) {
    .faq {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
  @media (max-width: 720px) {
    details p {
      padding-right: 0;
    }
  }
</style>
