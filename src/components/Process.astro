---
// Tabbed steps with a navy stage that swaps the matching mock.
// Pass one mock per step in slots named pane-0, pane-1, ...
interface Props {
  steps: { title: string; text: string }[];
}
const { steps } = Astro.props;
const uid = "process";
const panes = await Promise.all(
  steps.map((_, i) => Astro.slots.render(`pane-${i}`)),
);
---

<div class="process" data-process>
  <div>
    <div class="steps" role="tablist" aria-label="Process steps">
      {steps.map((s, i) => (
        <button
          class="step"
          role="tab"
          type="button"
          id={`${uid}-t${i}`}
          aria-controls={`${uid}-p${i}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
        >
          <span class="n">{String(i + 1).padStart(2, "0")}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <span class="prog" />
        </button>
      ))}
    </div>
    <div class="ctas">
      <slot name="ctas" />
    </div>
  </div>
  <div class="stage">
    {panes.map((html, i) => (
      <div
        class:list={["pane", i === 0 && "on"]}
        id={`${uid}-p${i}`}
        role="tabpanel"
        aria-labelledby={`${uid}-t${i}`}
        hidden={i !== 0}
        set:html={html}
      />
    ))}
  </div>
</div>

<script>
  // Auto-advance every --tab-interval while visible; stop after a manual pick.
  document.querySelectorAll<HTMLElement>("[data-process]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const interval =
      parseFloat(getComputedStyle(root).getPropertyValue("--tab-interval")) *
      1000;
    let current = 0;
    let timer: number | undefined;
    let auto = !matchMedia("(prefers-reduced-motion: reduce)").matches;

    const show = (i: number) => {
      tabs.forEach((t, k) => {
        const on = k === i;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        const pane = document.getElementById(
          t.getAttribute("aria-controls") ?? "",
        );
        if (pane) {
          pane.hidden = !on;
          pane.classList.toggle("on", on);
        }
        const bar = t.querySelector<HTMLElement>(".prog");
        if (!bar) return;
        bar.classList.remove("run");
        void bar.offsetWidth; // restart the progress animation
        if (on && auto) bar.classList.add("run");
      });
      current = i;
    };
    const stop = () => {
      auto = false;
      clearInterval(timer);
    };
    const start = () => {
      if (!auto) return;
      clearInterval(timer);
      timer = window.setInterval(
        () => show((current + 1) % tabs.length),
        interval,
      );
      show(current);
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => {
        stop();
        show(i);
      });
      t.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
        e.preventDefault();
        const n =
          (i + (e.key === "ArrowDown" ? 1 : -1) + tabs.length) % tabs.length;
        stop();
        show(n);
        tabs[n].focus();
      });
    });
    new IntersectionObserver(
      ([e]) => (e.isIntersecting ? start() : clearInterval(timer)),
      { threshold: 0.3 },
    ).observe(root);
  });
</script>

<style>
  .process {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--space-14);
    align-items: start;
    margin-top: var(--space-12);
  }
  .steps {
    display: grid;
    gap: var(--space-2);
  }
  .step {
    position: relative;
    display: block;
    width: 100%;
    padding: var(--space-5-5) var(--space-6);
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: var(--r-card);
    background: transparent;
    color: var(--ink);
    text-align: left;
    cursor: pointer;
    transition:
      background var(--dur),
      border-color var(--dur);
  }
  .n {
    color: var(--muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }
  .step h3 {
    margin-top: var(--space-1);
  }
  .step p {
    display: none;
    margin-top: var(--space-2);
    color: var(--muted);
    font-size: var(--text-15);
  }
  .step[aria-selected="true"] {
    border-color: var(--line);
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .step[aria-selected="true"] p {
    display: block;
  }
  .prog {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: var(--prog-h);
    background: var(--navy);
    transform: scaleX(0);
    transform-origin: left;
  }
  .step[aria-selected="true"] :global(.prog.run) {
    animation: prog var(--tab-interval) linear forwards;
  }
  @keyframes prog {
    to {
      transform: scaleX(1);
    }
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-7);
    padding-left: var(--space-6);
  }
  .stage {
    position: sticky;
    top: var(--sticky-top);
    display: grid;
    place-items: center;
    min-height: var(--feature-min-h);
    padding: var(--space-7);
    border-radius: var(--r-panel);
    background: var(--navy);
  }
  .pane {
    width: 100%;
    max-width: var(--pane-max);
  }
  .pane[hidden] {
    display: none;
  }
  .pane.on {
    animation: rise var(--dur-pane) var(--ease) both;
  }
  @media (max-width: 1080px) {
    .process {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .stage {
      position: static;
    }
  }
  @media (max-width: 720px) {
    .stage {
      min-height: 0;
      padding: var(--space-4);
      border-radius: var(--r-panel-sm);
    }
    .ctas {
      padding-left: 0;
    }
  }
</style>
