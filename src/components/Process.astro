---
// Tabbed steps with a navy stage that swaps the matching mock.
// Pass one mock per step in slots named pane-0, pane-1, ...
interface Props {
  steps: { title: string; text: string }[];
  // Unique per page when a page has more than one Process block.
  id?: string;
}
const { steps, id: uid = "process" } = Astro.props;
const panes = await Promise.all(
  steps.map((_, i) => Astro.slots.render(`pane-${i}`)),
);
---

<div class="process" data-process>
  <div>
    <div
      class="steps"
      role="tablist"
      aria-label="Process steps"
      aria-orientation="vertical"
    >
      {steps.map((s, i) => (
        <button
          class="step"
          role="tab"
          type="button"
          id={`${uid}-t${i}`}
          aria-controls={`${uid}-p${i}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
        >
          <span class="n">{String(i + 1).padStart(2, "0")}</span>
          <span class="title">{s.title}</span>
          <span class="text">{s.text}</span>
          <span class="prog" />
        </button>
      ))}
    </div>
    <div class="ctas">
      <slot name="ctas" />
    </div>
  </div>
  <div class="stage">
    {panes.map((html, i) => (
      <div
        class:list={["pane", i === 0 && "on"]}
        id={`${uid}-p${i}`}
        role="tabpanel"
        aria-labelledby={`${uid}-t${i}`}
        hidden={i !== 0}
        set:html={html}
      />
    ))}
  </div>
</div>

<script>
  import "../scripts/tabs";
</script>

<style>
  .process {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--space-14);
    align-items: start;
    margin-top: var(--space-12);
  }
  .steps {
    display: grid;
    gap: var(--space-2);
  }
  .step {
    position: relative;
    display: block;
    width: 100%;
    padding: var(--space-5-5) var(--space-6);
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: var(--r-card);
    background: transparent;
    color: var(--ink);
    text-align: left;
    cursor: pointer;
    transition:
      background var(--dur),
      border-color var(--dur);
  }
  .n {
    color: var(--muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }
  .title {
    display: block;
    margin-top: var(--space-1);
    color: var(--navy);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-h3);
  }
  .text {
    display: none;
    margin-top: var(--space-2);
    color: var(--muted);
    font-size: var(--text-15);
  }
  .step[aria-selected="true"] {
    border-color: var(--line);
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .step[aria-selected="true"] .text {
    display: block;
  }
  .prog {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: var(--prog-h);
    background: var(--navy);
    transform: scaleX(0);
    transform-origin: left;
  }
  .step[aria-selected="true"] :global(.prog.run) {
    animation: prog var(--tab-interval) var(--ease-linear) forwards;
  }
  @keyframes prog {
    to {
      transform: scaleX(1);
    }
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-7);
    padding-left: var(--space-6);
  }
  .stage {
    position: sticky;
    top: var(--sticky-top);
    display: grid;
    place-items: center;
    min-height: var(--feature-min-h);
    padding: var(--space-7);
    border-radius: var(--r-panel);
    background: var(--navy);
  }
  .pane {
    width: 100%;
    max-width: var(--pane-max);
  }
  .pane[hidden] {
    display: none;
  }
  .pane.on {
    animation: rise var(--dur-pane) var(--ease) both;
  }
  @media (max-width: 1080px) {
    .process {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .stage {
      position: static;
    }
  }
  @media (max-width: 720px) {
    .stage {
      min-height: 0;
      padding: var(--space-4);
      border-radius: var(--r-panel-sm);
    }
    .ctas {
      padding-left: 0;
    }
  }
</style>
