---
// Hero mock: example valuation estimate, for a given sector if passed.
import Chip from "../Chip.astro";
import MockCard from "./MockCard.astro";

interface Props {
  sector?: string;
  range?: string;
  note?: string;
}
const {
  sector = "Business services",
  range = "3x to 7x",
  note = "EBITDA",
} = Astro.props;
// Places the range on a scale from 0x to 1.4 times its top end, so the
// segment always has room on both sides of the track.
const [lo, hi] = (range.match(/\d+(\.\d+)?/g) ?? ["0", "0"]).map(Number);
const pct = (v: number) => `${((v / (hi * 1.4)) * 100).toFixed(1)}%`;
---

<MockCard title="Valuation estimate" chip="Example" chipTone="quiet">
  <div class="grid">
    <div class="field">
      <small>Sector</small>
      <b>{sector}</b>
    </div>
    <div class="field">
      <small>Location</small>
      <b>Dubai, UAE</b>
    </div>
  </div>
  <div class="range">
    <small>Price as a multiple of yearly profit</small>
    <div class="row">
      <b>{range}</b>
      <Chip>{note}</Chip>
    </div>
    <svg class="scale" aria-hidden="true">
      <rect class="track" width="100%"></rect>
      <rect class="fill" x={pct(lo)} width={pct(hi - lo)}></rect>
      <text x={pct(lo)} y="100%">
        {lo}x
      </text>
      <text x={pct(hi)} y="100%" text-anchor="end">
        {hi}x
      </text>
    </svg>
  </div>
</MockCard>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2-5);
  }
  .field {
    padding: var(--space-2-5) var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--r-inner);
  }
  small {
    display: block;
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .field b {
    font-size: var(--text-14);
    font-weight: var(--weight-semibold);
  }
  .range {
    margin-top: var(--space-3-5);
    padding: var(--space-3-5);
    border-radius: var(--r-inner);
    background: var(--sky-soft);
  }
  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 2px;
  }
  .row b {
    color: var(--navy);
    font-size: var(--text-range);
    letter-spacing: var(--tracking-num-sm);
    font-variant-numeric: tabular-nums;
  }
  .scale {
    display: block;
    width: 100%;
    height: var(--scale-h);
    margin-top: var(--space-3);
    overflow: visible;
  }
  .scale rect {
    height: var(--bar-h);
    rx: calc(var(--bar-h) / 2);
  }
  .track {
    fill: var(--line-strong);
  }
  .fill {
    fill: var(--navy);
    transform-box: fill-box;
    transform-origin: left;
    animation: grow var(--dur-bar) var(--delay-bar) var(--ease) both;
  }
  .scale text {
    fill: var(--muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }
  @keyframes grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
