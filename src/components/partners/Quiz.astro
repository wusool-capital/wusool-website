---
// Four questions, matched in the browser against the directory below. No
// request leaves the page; the answers are not stored yet (PRD 6.3).
import Icon from "../Icon.astro";
import { CATEGORIES, HORIZONS, LOCATIONS, SIZES } from "../../lib/partners";

const groups = [
  {
    name: "need",
    legend: "What do you need now?",
    hint: "Pick one or more.",
    type: "checkbox" as const,
    options: CATEGORIES.map((c) => ({ value: c.value, label: c.need })),
  },
  {
    name: "size",
    legend: "Yearly revenue",
    type: "radio" as const,
    options: SIZES,
  },
  {
    name: "location",
    legend: "Where is the company set up?",
    type: "radio" as const,
    options: LOCATIONS,
  },
  {
    name: "horizon",
    legend: "When might you sell?",
    type: "radio" as const,
    options: HORIZONS,
  },
];
---

<details class="quiz" data-quiz>
  <summary>
    <span class="ask">
      <strong>Not sure where to start?</strong>
      <span>Answer four questions and we suggest up to three partners.</span>
    </span>
    <span class="open">
      Find my partners <Icon name="caret-down" />
    </span>
  </summary>
  <form novalidate>
    {groups.map((g) => (
      <fieldset>
        <legend>
          {g.legend}
          {g.hint && <span>{g.hint}</span>}
        </legend>
        <div class="opts">
          {g.options.map((o) => (
            <label>
              <input
                type={g.type}
                name={g.name}
                value={o.value}
                required={g.type === "radio"}
              />
              <span>{o.label}</span>
            </label>
          ))}
        </div>
      </fieldset>
    ))}
    <p class="err" role="alert" data-quiz-error hidden>
      Answer the four questions to see your matches.
    </p>
    <button type="submit" class="submit">
      Show my matches <Icon name="arrow-right" />
    </button>
  </form>
  <div class="res" data-quiz-results hidden>
    <h2 tabindex="-1">Your matches</h2>
    <ul class="list" data-quiz-list></ul>
    <p class="none" data-quiz-none hidden>
      No partner fits these answers yet. Browse all partners below.
    </p>
    <p class="next" data-next="none">
      If you decide to sell one day, a{" "}
      <a href="/valuation-tool">free valuation</a> shows where you stand.
    </p>
    <p class="next" data-next="1-2y" hidden>
      Selling within two years? Start with a{" "}
      <a href="/valuation-tool">free valuation</a> and a{" "}
      <a href="/deal-readiness-tool">readiness check</a>.
    </p>
    <p class="next" data-next="3y" hidden>
      Planning further out? A <a href="/deal-readiness-tool">readiness check</a>{" "}
      shows what to fix first.
    </p>
    <button type="button" class="again" data-quiz-again>
      Change my answers
    </button>
  </div>
</details>

<style>
  .quiz {
    max-width: var(--tool-w);
    margin: 0 auto;
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--r-panel);
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  summary {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    align-items: center;
    justify-content: space-between;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .ask {
    display: grid;
    gap: var(--space-1);
  }
  .ask strong {
    color: var(--navy);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
  }
  .ask span {
    color: var(--muted);
    font-size: var(--text-15);
  }
  .open {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    padding: var(--space-2-5) var(--space-5);
    border-radius: var(--r-pill);
    background: var(--navy);
    color: var(--on-navy);
    font-weight: var(--weight-semibold);
  }
  .quiz[open] .open :global(.icon) {
    transform: scaleY(-1);
  }
  .quiz[open] > form,
  .quiz[open] > .res {
    margin-top: var(--space-4);
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
  }
  h2 {
    color: var(--navy);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
  }
  fieldset {
    margin: var(--space-8) 0 0;
    padding: 0;
    border: 0;
  }
  legend {
    margin-bottom: var(--space-3);
    font-weight: var(--weight-semibold);
  }
  legend span {
    margin-left: var(--space-2);
    color: var(--muted);
    font-size: var(--text-14);
    font-weight: normal;
  }
  .opts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .opts label {
    position: relative;
  }
  .opts input {
    position: absolute;
    opacity: 0;
  }
  .opts span {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    font-size: var(--text-15);
    cursor: pointer;
  }
  .opts input:checked + span {
    border-color: var(--navy);
    background: var(--navy);
    color: var(--on-navy);
  }
  .opts input:focus-visible + span {
    outline: 2px solid var(--navy);
    outline-offset: 2px;
  }
  .err {
    margin-top: var(--space-6);
    color: var(--navy);
    font-weight: var(--weight-medium);
  }
  .submit {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    margin-top: var(--space-8);
    padding: var(--space-3) var(--space-6);
    border: 0;
    border-radius: var(--r-pill);
    background: var(--navy);
    color: var(--on-navy);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }
  .submit:hover {
    background: var(--navy-2);
  }
  .list {
    display: grid;
    grid-template-columns: repeat(
      auto-fill,
      minmax(min(100%, var(--card-min)), 1fr)
    );
    gap: var(--space-4);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }
  .none,
  .next {
    margin-top: var(--space-6);
    color: var(--muted);
  }
  .next a {
    color: var(--navy);
    font-weight: var(--weight-semibold);
    text-decoration: underline;
    text-underline-offset: var(--nudge);
  }
  .again {
    margin-top: var(--space-4);
    padding: 0;
    border: 0;
    background: none;
    color: var(--navy);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }
  [hidden] {
    display: none;
  }
  @media (max-width: 640px) {
    .quiz {
      padding: var(--space-5);
    }
    .open {
      width: 100%;
      justify-content: center;
    }
  }
</style>
