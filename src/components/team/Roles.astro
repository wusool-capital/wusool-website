---
// Open roles as rows linking to each role page.
import Icon from "../Icon.astro";
import type { Role } from "../../lib/pages";

interface Props {
  roles: Role[];
  empty?: string;
}
const { roles, empty } = Astro.props;
---

{roles.length > 0 ? (
  <ul class="roles">
    {roles.map((r) => (
      <li class="reveal">
        <a href={`/careers/${r.slug}`}>
          <span class="name">{r.name}</span>
          <span class="facts">
            {[r.location, r.employmentType, r.department]
              .filter(Boolean)
              .join(" · ")}
          </span>
          <Icon name="arrow-right" class="arrow" />
        </a>
      </li>
    ))}
  </ul>
) : (
  empty && <p class="empty">{empty}</p>
)}

<style>
  .roles {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-10) 0 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: var(--space-6);
    align-items: center;
    padding: var(--space-6) var(--space-7);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface);
  }
  a:hover {
    border-color: var(--sky);
    background: var(--sky-soft);
  }
  .name {
    color: var(--navy);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
  }
  .facts {
    color: var(--muted);
    font-size: var(--text-14);
  }
  a :global(.arrow) {
    color: var(--navy);
  }
  .empty {
    margin-top: var(--space-8);
    color: var(--muted);
  }
  @media (max-width: 720px) {
    a {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .facts {
      grid-row: 2;
    }
  }
</style>
