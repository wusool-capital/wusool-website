---
// Results: one peer band per metric. The script fills the template below.
import { QLABEL } from "../../../lib/tools/benchmark";
---

<h2 tabindex="-1">Where you sit</h2>
<p class="sub">
  Your position against the peer set in your sector and size band.
</p>
<p class="visually-hidden" aria-live="polite" id="bm-status"></p>
<p class="cover" id="bm-cover" hidden></p>
<div id="bm-metrics"></div>

<template id="bm-metric">
  <div class="metric">
    <div class="mhead">
      <span class="mname"></span>
      <span class="pill"></span>
    </div>
    <p class="visually-hidden desc"></p>
    <div class="band" aria-hidden="true">
      <span class="track"></span>
      <span class="tick t25"></span>
      <span class="tick t50"></span>
      <span class="tick t75"></span>
      <span class="medlab"></span>
      <span class="mark">
        <span class="mval"></span>
      </span>
    </div>
    <div class="qlabels" aria-hidden="true">
      {QLABEL.slice(1).map((l) => (
        <span>{l}</span>
      ))}
    </div>
  </div>
</template>

<style>
  h2 {
    font-size: var(--text-range);
  }
  .cover {
    margin-bottom: var(--space-4);
    padding: var(--space-3);
    border-radius: var(--r-inner);
    background: var(--sky-soft);
    color: var(--navy);
    font-size: var(--text-sm);
  }
  .metric {
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--line);
  }
  .mhead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }
  .mname {
    color: var(--navy);
    font-weight: var(--weight-medium);
  }
  .pill {
    padding: var(--chip-pad);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    background: var(--surface);
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    white-space: nowrap;
  }
  [data-q="2"] .pill {
    border-color: var(--sky);
    background: var(--sky-soft);
    color: var(--navy);
  }
  [data-q="3"] .pill {
    border-color: var(--sky);
    background: var(--sky);
    color: var(--navy);
  }
  [data-q="4"] .pill {
    border-color: var(--navy);
    background: var(--navy);
    color: var(--on-navy);
  }
  .band {
    position: relative;
    height: var(--space-6);
  }
  .track {
    position: absolute;
    inset: var(--space-2) 0 auto;
    height: var(--space-2);
    border-radius: var(--r-pill);
    background: linear-gradient(
      to right,
      var(--page),
      var(--sky-soft) 45%,
      var(--sky)
    );
  }
  .tick {
    position: absolute;
    top: var(--space-1-5);
    width: 1px;
    height: var(--space-3-5);
    background: var(--line-strong);
  }
  .t25 {
    left: 25%;
  }
  .t50 {
    left: 50%;
  }
  .t75 {
    left: 75%;
  }
  .mark {
    position: absolute;
    top: var(--space-1);
    left: var(--pos);
    width: var(--bm-mark-w);
    height: var(--space-4);
    border-radius: var(--r-pill);
    background: var(--navy);
    box-shadow: 0 0 0 var(--bm-mark-w) var(--surface);
    transition: left var(--dur-slow) var(--ease);
  }
  .mval,
  .medlab {
    position: absolute;
    bottom: calc(100% + var(--space-1-5));
    font-size: var(--text-sm);
    white-space: nowrap;
  }
  .mval {
    left: 50%;
    transform: translateX(-50%);
    color: var(--navy);
    font-weight: var(--weight-semibold);
  }
  [data-edge="start"] .mval {
    transform: translateX(-1px);
  }
  [data-edge="end"] .mval {
    transform: translateX(-100%);
  }
  .medlab {
    left: 50%;
    bottom: calc(100% + 2px);
    transform: translateX(-50%);
    color: var(--muted);
    font-size: var(--text-xs);
  }
  [data-shift="right"] .medlab {
    transform: translateX(calc(-50% + var(--bm-med-shift)));
  }
  [data-shift="left"] .medlab {
    transform: translateX(calc(-50% - var(--bm-med-shift)));
  }
  .qlabels {
    display: flex;
    gap: var(--space-2);
    line-height: var(--leading-snug);
    margin-top: var(--space-2);
  }
  .qlabels span {
    flex: 1;
    color: var(--muted);
    font-size: var(--text-xs);
    text-align: center;
  }
</style>
