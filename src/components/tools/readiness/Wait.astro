---
// Shown while the server scores the answers (it can take a minute or two),
// and when scoring fails. Filled in by the script.
---

<section class="wait" data-loading hidden>
  <h2 tabindex="-1">Scoring your answers</h2>
  <progress aria-label="Scoring in progress"></progress>
  <p data-loading-text></p>
</section>

<section class="wait" data-failed hidden>
  <h2 tabindex="-1">We could not score your answers</h2>
  <p role="alert" data-failed-text></p>
  <button type="button" class="retry" data-retry>
    Try again
  </button>
</section>

<style>
  .wait {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding: var(--space-10) 0;
    text-align: center;
  }
  .wait[hidden] {
    display: none;
  }
  .wait p {
    color: var(--muted);
  }
  progress {
    width: 100%;
    max-width: var(--measure-lede);
  }
  .retry {
    height: var(--btn-h);
    padding: 0 var(--btn-pad-x);
    border: 0;
    border-radius: var(--r-pill);
    background: var(--navy);
    color: var(--on-navy);
    font-size: var(--text-15);
    font-weight: var(--weight-medium);
    cursor: pointer;
  }
  .retry:hover {
    background: var(--navy-2);
  }
</style>
