---
// A group of radio pills in a fieldset with a legend.
interface Props {
  name: string;
  legend: string;
  options: string[];
  value?: string;
  required?: boolean;
}
const { name, legend, options, value, required = false } = Astro.props;
const id = `val-${name}`;
---

<fieldset class="choice" aria-describedby={`${id}-error`}>
  <legend>{legend}</legend>
  <div class="pills">
    {options.map((o) => (
      <label>
        <input
          type="radio"
          name={name}
          value={o}
          checked={o === value}
          required={required}
        />
        <span>{o}</span>
      </label>
    ))}
  </div>
  <p class="error" id={`${id}-error`} data-error={name} hidden></p>
</fieldset>

<style>
  .choice {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  legend {
    margin-bottom: var(--space-1-5);
    padding: 0;
    color: var(--ink);
    font-size: var(--text-14);
    font-weight: var(--weight-medium);
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  label {
    position: relative;
    flex: 1;
  }
  input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
  }
  span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--btn-h-sm);
    padding: 0 var(--space-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    background: var(--surface);
    color: var(--ink);
    font-size: var(--text-14);
    cursor: pointer;
    transition:
      background var(--dur-base),
      border-color var(--dur-base);
  }
  span:hover {
    border-color: var(--navy);
  }
  input:checked + span {
    border-color: var(--navy);
    background: var(--navy);
    color: var(--on-navy);
    font-weight: var(--weight-semibold);
  }
  input:focus-visible + span {
    outline: 2px solid var(--navy);
    outline-offset: 2px;
  }
  .error {
    margin-top: var(--space-1-5);
    color: var(--navy);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }
</style>
