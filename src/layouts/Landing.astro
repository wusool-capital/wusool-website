---
// A landing page document from Sanity: head, structured data and sections.
// Home carries the full organization and website nodes; other pages refer to
// them by @id and add a Service and breadcrumbs (PRD Appendix B).
import Base from "./Base.astro";
import Announce from "../components/Announce.astro";
import Sections from "../components/Sections.astro";
import { loadPage, faqOf, visibleSections, tone } from "../lib/pages";
import { imageUrl } from "../lib/sanity";
import {
  SITE,
  graph,
  organization,
  website,
  webPage,
  faqPage,
  service,
  breadcrumbs,
} from "../lib/schema";

interface Props {
  id: string;
  // Breadcrumb name and data-source prefix, e.g. "Sell" and "sell".
  name: string;
  source: string;
  // Schema.org type of the page node, e.g. AboutPage on Team.
  pageType?: string;
  // Extra structured data nodes, e.g. a Person per team member.
  nodes?: Record<string, unknown>[];
}
const { id, name, source, pageType, nodes = [] } = Astro.props;
const { page, settings, banner, posts, deals, roles, team } =
  await loadPage(id);
const home = id === "page-home";
const path = Astro.url.pathname.replace(/(index)?\.html$/, "");
const url = home ? `${SITE}/` : `${SITE}${path}`;
const faq = faqOf(page.sections);
// The top area matches the first section under the hero, the footer area
// matches the last section.
const shown = visibleSections(page.sections, deals, posts);
const afterHero = shown[shown[0]?._type === "heroSection" ? 1 : 0];
const top = tone(afterHero);
const bottom = tone(shown[shown.length - 1]);
const c = page.closingCta;
const closing =
  c?.title && c.button?.label
    ? {
        title: c.title,
        text: c.text,
        label: c.button.label,
        href: c.button.href,
        form: c.button.form,
      }
    : undefined;

const crumbs = home
  ? []
  : [
      breadcrumbs(url, [
        { name: "Home", url: `${SITE}/` },
        { name, url },
      ]),
    ];
const jsonLd = graph([
  ...(home ? [organization(settings), website()] : []),
  {
    ...webPage(url, page.seo.title, page.seo.description),
    ...(pageType ? { "@type": pageType } : {}),
    ...(home ? {} : { breadcrumb: { "@id": `${url}#breadcrumb` } }),
  },
  ...(page.service?.name
    ? [service(url, page.service, settings.areaServed)]
    : []),
  ...(faq.length ? [faqPage(url, faq)] : []),
  ...nodes,
  ...crumbs,
]);
---

<Base
  title={page.seo.title}
  description={page.seo.description}
  og={{
    title: page.seo.ogTitle,
    description: page.seo.ogDescription,
    image: page.seo.ogImage && imageUrl(page.seo.ogImage, 1200, 630),
  }}
  jsonLd={jsonLd}
  top={top}
  bottom={bottom}
  closing={closing}
>
  {home && banner && (
    <Announce
      slot="announce"
      href={`/reports/${banner.slug}`}
      slug={banner.slug}
      lead="Just released:"
      title={banner.title}
      cta="Get the playbook"
    />
  )}
  <Sections
    sections={page.sections}
    deals={deals}
    posts={posts}
    roles={roles}
    team={team}
    page={source}
  />
</Base>
