---
// Home: the "Home" landing page in Sanity. Sections render in the order set
// in Studio, one component per section type (PRD 6).
import Base from "../layouts/Base.astro";
import Announce from "../components/Announce.astro";
import Hero from "../components/Hero.astro";
import Button from "../components/Button.astro";
import ArrowLink from "../components/ArrowLink.astro";
import SectionHead from "../components/SectionHead.astro";
import Stats from "../components/Stats.astro";
import Compare from "../components/Compare.astro";
import IndustryGrid from "../components/IndustryGrid.astro";
import Process from "../components/Process.astro";
import DealsTable from "../components/DealsTable.astro";
import Posts from "../components/Posts.astro";
import Faq from "../components/Faq.astro";
import ValuationMock from "../components/mocks/ValuationMock.astro";
import BuyersMock from "../components/mocks/BuyersMock.astro";
import BusinessMock from "../components/mocks/BusinessMock.astro";
import ShortlistMock from "../components/mocks/ShortlistMock.astro";
import ProgressMock from "../components/mocks/ProgressMock.astro";
import { query, imageUrl } from "../lib/sanity";
import {
  SITE,
  graph,
  organization,
  website,
  webPage,
  faqPage,
  type OrgSettings,
} from "../lib/schema";

type Link = { label?: string; href?: string };
// Section fields come from Studio; each block below checks what it needs.
// eslint-disable-next-line @typescript-eslint/no-explicit-any
type Section = { _type: string; _key: string; [k: string]: any };

const data = await query<{
  page: {
    seo: {
      title: string;
      description: string;
      ogTitle?: string;
      ogDescription?: string;
      ogImage?: string;
    };
    sections: Section[];
  };
  settings: OrgSettings;
  banner?: { title: string; slug: string };
  posts: { title: string; slug: string; excerpt: string; silo: string }[];
  deals: {
    category: string;
    status: string;
    sector: string;
    country: string;
    year: string;
    oneLineDescription: string;
  }[];
}>(`{
  "page": *[_id == "page-home"][0]{
    seo{..., "ogImage": ogImage.asset._ref},
    sections[]{..., _type == "sectorGridSection" => {tiles[]{..., "slug": industry->slug.current}}}
  },
  "settings": *[_id == "siteSettings"][0],
  "banner": *[_type == "report" && bannerPinned == true][0]{title, "slug": slug.current},
  "posts": *[_type == "insights" && hideFromListings != true] | order(featured desc, publishedAt desc)[0...3]{
    title, "slug": slug.current, excerpt, silo
  },
  "deals": *[_type == "transaction"] | order(sortOrder asc)
}`);
if (!data.page?.seo?.title || !data.page.seo.description) {
  throw new Error("Sanity: the Home page needs an SEO title and description");
}
const { page, settings, banner, posts, deals } = data;
const sections = page.sections ?? [];
const has = (l?: Link): l is Required<Link> => !!(l?.label && l?.href);

// Industry icons live in the repo, keyed by industry slug.
const icons = import.meta.glob<string>("../assets/industries/*.svg", {
  query: "?url",
  import: "default",
  eager: true,
});
const icon = (slug: string) =>
  icons[`../assets/industries/${slug}.svg`] ??
  icons["../assets/industries/business-services.svg"];

// A large glyph per topic for the lead insight card.
const glyphs: Record<string, string> = {
  "Sell Your Business": "storefront",
  "Business Valuation": "chart-line-up",
  "Exit Strategy": "sign-out",
  "Buy a Business": "handshake",
  "GCC M&A Market": "globe-hemisphere-east",
  "Entrepreneurship Through Acquisition (ETA) GCC": "compass",
};
const post = (p: (typeof posts)[number]) => ({
  href: `/insights/${p.slug}`,
  title: p.title,
  excerpt: p.excerpt,
});

// The FAQ schema uses exactly the questions shown on the page.
const faqItems: { question: string; answer: string }[] = (
  sections.find((s) => s._type === "faqSection")?.faq ?? []
).filter((i: { question?: string; answer?: string }) => i.question && i.answer);

const url = `${SITE}/`;
const jsonLd = graph([
  organization(settings),
  website(),
  webPage(url, page.seo.title, page.seo.description),
  ...(faqItems.length ? [faqPage(url, faqItems)] : []),
]);

// Section spacing as in index.html: a section that follows a plain section
// on the page background drops its top padding.
const plain = new Set([
  "comparisonSection",
  "dealsSection",
  "sectorGridSection",
  "postsSection",
]);
const rendered = sections.filter((s) =>
  s._type === "dealsSection"
    ? deals.length > 0
    : s._type === "postsSection"
      ? posts.length === 3
      : true,
);
const flush = (i: number) =>
  plain.has(rendered[i]._type) && plain.has(rendered[i - 1]?._type);
---

<Base
  title={page.seo.title}
  description={page.seo.description}
  og={{
    title: page.seo.ogTitle,
    description: page.seo.ogDescription,
    image: page.seo.ogImage && imageUrl(page.seo.ogImage, 1200, 630),
  }}
  jsonLd={jsonLd}
>
  {banner && (
    <Announce
      slot="announce"
      href={`/reports/${banner.slug}`}
      lead="Just released:"
      title={banner.title}
      cta="Get the playbook"
    />
  )}

  {rendered.map((s, i) => {
    switch (s._type) {
      case "heroSection": {
        const [first, second] = (s.ctas ?? []).filter(has);
        return (
          <Hero label={s.label} title={s.title} soft={s.soft} sub={s.sub}>
            <Fragment slot="ctas">
              {first && (
                <Button href={first.href} variant="light" source="home-hero">
                  {first.label}
                </Button>
              )}
              {second && (
                <Button
                  href={second.href}
                  variant="ghost-dark"
                  source="home-hero"
                >
                  {second.label}
                </Button>
              )}
            </Fragment>
            <ValuationMock />
            <BuyersMock />
          </Hero>
        );
      }
      case "statsSection":
        return <Stats items={s.items ?? []} />;
      case "comparisonSection":
        return (
          <section
            class:list={["section", flush(i) && "section--flush-top"]}
            id="compare"
          >
            <div class="wrap">
              <SectionHead title={s.title} lede={s.lede} />
              <Compare
                old={{ title: s.oldTitle, items: s.oldItems ?? [] }}
                better={{ title: s.newTitle, items: s.newItems ?? [] }}
              />
              {has(s.cta) && (
                <div class="after reveal">
                  <Button href={s.cta.href} source="home-compare">
                    {s.cta.label}
                  </Button>
                </div>
              )}
            </div>
          </section>
        );
      case "sectorGridSection":
        return (
          <section
            class:list={["section", flush(i) && "section--flush-top"]}
            id="industries"
          >
            <div class="wrap">
              <SectionHead title={s.title} lede={s.lede} />
              <IndustryGrid
                items={(s.tiles ?? [])
                  .filter(
                    (t: { slug?: string; title?: string }) => t.slug && t.title,
                  )
                  .map(
                    (t: {
                      slug: string;
                      title: string;
                      text: string;
                      cta: string;
                    }) => ({
                      href: `/industries/${t.slug}`,
                      icon: icon(t.slug),
                      title: t.title,
                      text: t.text,
                      cta: t.cta,
                    }),
                  )}
              />
              {has(s.footLink) && (
                <div class="after reveal">
                  <ArrowLink href={s.footLink.href} source="home-industries">
                    {s.footLink.label}
                  </ArrowLink>
                </div>
              )}
            </div>
          </section>
        );
      case "processSection":
        return (
          <section class="section section--surface" id="process">
            <div class="wrap">
              <SectionHead label={s.label} title={s.title} lede={s.lede} />
              <Process steps={(s.steps ?? []).slice(0, 3)}>
                <Fragment slot="ctas">
                  {has(s.primary) && (
                    <Button href={s.primary.href} source="home-process">
                      {s.primary.label}
                    </Button>
                  )}
                  {has(s.secondary) && (
                    <ArrowLink href={s.secondary.href} source="home-process">
                      {s.secondary.label}
                    </ArrowLink>
                  )}
                </Fragment>
                <BusinessMock slot="pane-0" />
                <ShortlistMock slot="pane-1" />
                <ProgressMock slot="pane-2" />
              </Process>
            </div>
          </section>
        );
      case "dealsSection":
        return (
          <section
            class:list={["section", flush(i) && "section--flush-top"]}
            id="transactions"
          >
            <div class="wrap">
              <SectionHead label={s.label} title={s.title} lede={s.lede} />
              <DealsTable
                note={s.note}
                rows={deals.map((d) => ({
                  mandate: d.category,
                  status: d.status,
                  closed: d.status === "Closed" || d.status === "Completed",
                  sector: d.sector,
                  country: d.country,
                  year: d.year,
                  summary: d.oneLineDescription,
                }))}
              >
                {has(s.footLink) && (
                  <ArrowLink href={s.footLink.href} source="home-deals">
                    {s.footLink.label}
                  </ArrowLink>
                )}
              </DealsTable>
            </div>
          </section>
        );
      case "postsSection":
        return (
          <section
            class:list={["section", flush(i) && "section--flush-top"]}
            id="insights"
          >
            <div class="wrap">
              <div class="posts-head">
                <SectionHead title={s.title} />
                {has(s.allLink) && (
                  <ArrowLink
                    href={s.allLink.href}
                    class="reveal"
                    source="home-insights"
                  >
                    {s.allLink.label}
                  </ArrowLink>
                )}
              </div>
              <Posts
                lead={{
                  ...post(posts[0]),
                  glyph: glyphs[posts[0].silo] ?? "newspaper",
                }}
                side={posts.slice(1).map(post)}
              />
            </div>
          </section>
        );
      case "faqSection":
        return (
          <section class="section section--surface" id="faq">
            <div class="wrap">
              <Faq items={faqItems}>
                <SectionHead label={s.label} title={s.title} lede={s.lede} />
                {has(s.cta) && (
                  <Button href={s.cta.href} source="home-faq">
                    {s.cta.label}
                  </Button>
                )}
              </Faq>
            </div>
          </section>
        );
      default:
        return null;
    }
  })}
</Base>

<style>
  .after {
    margin-top: var(--space-8);
  }
  .posts-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-6);
  }
</style>
