---
// Author page per team member (PRD 8, fix 10): bio, expertise, links and the
// articles they wrote, with a ProfilePage and Person in the graph.
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/insights/Breadcrumbs.astro";
import InsightCard from "../../components/insights/InsightCard.astro";
import Prose from "../../components/insights/Prose.astro";
import Icon from "../../components/Icon.astro";
import { teamMembers, person, personId, type Member } from "../../lib/team";
import {
  listedInsights,
  cardImage,
  topicOf,
  type InsightCard as Card,
} from "../../lib/insights";
import { html } from "../../lib/portable";
import { imageUrl } from "../../lib/sanity";
import { SITE, WEBSITE_ID, graph, breadcrumbs } from "../../lib/schema";

export async function getStaticPaths() {
  const [members, insights] = await Promise.all([
    teamMembers(),
    listedInsights(),
  ]);
  return members.map((member) => ({
    params: { slug: member.slug },
    props: {
      member,
      articles: insights.filter((i) => i.authorSlug === member.slug),
    },
  }));
}

const { member: m, articles } = Astro.props as {
  member: Member;
  articles: Card[];
};
if (!m.seoTitle || !m.seoDescription) {
  throw new Error(
    `Sanity: team member ${m.slug} needs an SEO title and description`,
  );
}
const url = `${SITE}/team/${m.slug}`;
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Team", href: "/team" },
  { name: m.name },
];
const jsonLd = graph([
  {
    "@type": "ProfilePage",
    "@id": `${url}#webpage`,
    url,
    name: m.seoTitle,
    description: m.seoDescription,
    isPartOf: { "@id": WEBSITE_ID },
    breadcrumb: { "@id": `${url}#breadcrumb` },
    mainEntity: { "@id": personId(m.slug) },
    inLanguage: "en",
  },
  person(m),
  breadcrumbs(
    url,
    crumbs.map((c) => ({
      name: c.name,
      url: c.href ? `${SITE}${c.href}` : url,
    })),
  ),
]);
const facts = [
  m.basedIn && ["Based in", m.basedIn],
  m.yearsOfExperience && ["Experience", m.yearsOfExperience],
  m.languages?.length && ["Languages", m.languages.join(", ")],
].filter(Boolean) as [string, string][];
const bio = html(m.bio);
---

<Base title={m.seoTitle} description={m.seoDescription} jsonLd={jsonLd}>
  <header class="head">
    <div class="wrap split">
      <div>
        <Breadcrumbs items={crumbs} />
        <h1>{m.name}</h1>
        {m.roleTitle && <p class="role">{m.roleTitle}</p>}
        {m.shortBio && <p class="lede">{m.shortBio}</p>}
        {facts.length > 0 && (
          <dl class="facts">
            {facts.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        )}
        {m.linkedinUrl && (
          <a class="social" href={m.linkedinUrl} rel="noopener me">
            <Icon name="linkedin-logo" />
            LinkedIn
          </a>
        )}
      </div>
      {m.headshot && (
        <img
          class="photo"
          src={imageUrl(m.headshot, 640, 640, "webp")}
          alt={`${m.name}, ${m.roleTitle ?? "Wusool Capital"}`}
          width="640"
          height="640"
          fetchpriority="high"
        />
      )}
    </div>
  </header>

  {(bio || m.expertiseTags?.length) && (
    <section class="section section--flush-top" aria-labelledby="about">
      <div class="wrap">
        <h2 id="about">About {m.name.split(" ")[0]}</h2>
        {bio && <Prose html={bio} />}
        {m.expertiseTags && m.expertiseTags.length > 0 && (
          <ul class="tags" aria-label="Expertise">
            {m.expertiseTags.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )}

  {articles.length > 0 && (
    <section class="section section--surface" aria-labelledby="articles">
      <div class="wrap">
        <h2 id="articles">Articles by {m.name}</h2>
        <div class="grid">
          {articles.map((a) => (
            <InsightCard
              href={`/insights/${a.slug}`}
              image={cardImage("insights", a)}
              title={a.title}
              topic={topicOf(a.silo)?.silo}
              meta={a.readingTime}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .head {
    padding: var(--space-10) 0 var(--space-16);
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: start;
  }
  h1 {
    margin-top: var(--space-8);
    font-size: var(--text-h2);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
  }
  .role {
    margin-top: var(--space-2);
    color: var(--navy);
    font-weight: var(--weight-medium);
  }
  .lede {
    max-width: var(--measure-lede);
    margin-top: var(--space-4);
    color: var(--muted);
    font-size: var(--text-lg);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-10);
    margin-top: var(--space-6);
  }
  dt {
    color: var(--muted);
    font-size: var(--text-14);
  }
  dd {
    margin: 0;
    font-weight: var(--weight-medium);
  }
  .social {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    margin-top: var(--space-6);
    color: var(--navy);
    font-weight: var(--weight-medium);
  }
  .social:hover {
    text-decoration: underline;
    text-underline-offset: var(--nudge);
  }
  .photo {
    justify-self: end;
    width: 100%;
    max-width: var(--preview-w);
    height: auto;
    border-radius: var(--r-card);
  }
  h2 {
    font-size: var(--text-range);
    font-weight: var(--weight-semibold);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: var(--chip-pad);
    border: 1px solid var(--sky);
    border-radius: var(--r-pill);
    background: var(--sky-soft);
    color: var(--navy);
    font-size: var(--text-sm);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  @media (max-width: 1080px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 720px) {
    .split,
    .grid {
      grid-template-columns: 1fr;
    }
    .photo {
      justify-self: start;
      max-width: var(--headshot-lg);
    }
  }
</style>
