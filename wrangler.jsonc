{
  "name": "wusool-website",
  // Jules's account. The login sees more than one, so wrangler needs it named.
  "account_id": "aa28a40954cce378e48680c2b5588dda",
  "compatibility_date": "2026-10-01",
  // Lets Workers Builds publish a preview URL per branch (wrangler preview).
  "previews": {},
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    // Unknown paths serve 404.html with a 404 status (PRD feature 11).
    "not_found_handling": "404-page",
  },
  // prod branch deploys here. wusoolcapital.com is attached at cutover only.
  "env": {
    "prod": {
      "name": "wusool-website-prod",
    },
  },
}
